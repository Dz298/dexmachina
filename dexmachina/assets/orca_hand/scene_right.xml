<?xml version="1.0" ?>
<mujoco model="ORCA hand right scene">

  <!-- eulerseq "XYZ" corresponds to URDF "rpy" -->
  <compiler angle="radian" eulerseq="XYZ" meshdir="meshes"/>

  <!-- Camera placement -->
  <statistic extent="0.3" center="0 0 0.15"/>
  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <!-- Assets-->
  <asset>
    <!-- Background -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <!-- Materials -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="white" rgba="1 1 1 1" shininess="0.5" specular="0.1"/>
    <material name="black" rgba="0.25 0.25 0.25 1" shininess="0.2" specular="0.05"/>
    <material name="invisible" rgba="1 1 1 0" shininess="0" specular="0"/>
  </asset>

  <!-- Default -->
  <default>
    <mesh scale="0.001 0.001 0.001"/>
    <!-- Visual classes -->
    <default class="visual_base">
      <geom conaffinity="0" condim="1" contype="0" group="2" type="mesh"/>
      <default class="skin">
        <geom material="white"/>
      </default>
      <default class="bone">
        <geom material="black"/>
      </default>
    </default>
    <!-- Collision class -->
    <default class="collision">
      <geom conaffinity="1" condim="3" contype="1" group="1" type="mesh"/>
    </default>
    <!-- Joints -->
    <joint armature="0.001" damping="0.1" frictionloss="0.001" limited="true" margin="0.01" type="hinge"/>
    <position ctrllimited="true" forcelimited="true" forcerange="-1 1" kp="2.0"/>
  </default>

  <worldbody>
    <!-- Lighting and floor -->
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Drum stick -->
    <body name="object" pos="0 0.2 0.5">
    <inertial pos="0 0 0" mass="0.1" fullinertia="0.00195 0.00195 0.00000236 0 0 0"/>
      <freejoint/>
      <geom type="capsule" size="0.0075 0.15" rgba="0.8 0.6 0.4 1" friction="0.85 0.005 0.0001"
            condim="6" priority="1" solimp="0.9 0.95 0.001" solref="0.002 1"/>
      <site name="site_object" pos="0 0 0"/>
    </body>
  </worldbody>

  <include file="models/mjcf/orcahand_right.mjcf"/>

</mujoco>
